#!/bin/sh
set -e

[ -n "${IPKG_INSTROOT:-}" ] && exit 0

. /lib/functions.sh
gid="$(group_add_next flowsplice)"
user_exists flowsplice || user_add flowsplice '' "$gid" FlowSplice /var/run/flowsplice /bin/false
mkdir -p /etc/flowsplice/state
chown flowsplice:flowsplice /etc/flowsplice/state
chmod 700 /etc/flowsplice/state
if [ ! -e /etc/flowsplice/state/server-authorization.json ]; then
	printf '%s\n' '{"version":1,"snapshot":{"generation":1,"credentials":[],"revocations":[]},"used_enrollment_requests":[]}' \
		>/etc/flowsplice/state/server-authorization.json
fi
if [ ! -e /etc/flowsplice/state/server-control-generation.json ]; then
	printf '%s\n' '{"next_generation":1}' \
		>/etc/flowsplice/state/server-control-generation.json
fi
chown flowsplice:flowsplice \
	/etc/flowsplice/state/server-authorization.json \
	/etc/flowsplice/state/server-control-generation.json
chmod 600 \
	/etc/flowsplice/state/server-authorization.json \
	/etc/flowsplice/state/server-control-generation.json
/etc/init.d/flowsplice enable
ubusd_pids="$(pidof ubusd 2>/dev/null || true)"
[ -z "$ubusd_pids" ] || kill -HUP $ubusd_pids
rm -f /tmp/luci-indexcache /tmp/luci-indexcache.*
rm -rf /tmp/luci-modulecache
/etc/init.d/rpcd reload >/dev/null 2>&1 || true
exit 0
