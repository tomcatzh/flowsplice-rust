msgstr "已签名的部署信任清单"

msgid "Server control signing key"
msgstr "服务端控制签名私钥"

msgid "The deployment root must certify its public key."
msgstr "其公钥必须由部署根认证。"

msgid "Signed control snapshot TTL (seconds)"
msgstr "签名控制快照有效期（秒）"
