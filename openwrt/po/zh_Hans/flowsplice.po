msgstr "停止"

msgid "The file must be readable by the flowsplice service user."
msgstr "flowsplice 服务用户必须能够读取此文件。"

msgid "Trust and identity"
msgstr "信任与身份"

msgid "Trusted Home Agents"
msgstr "受信任的家庭端"

msgid "Use LAN addresses only; do not expose the Server control listener to WAN."
msgstr "只能使用局域网地址；不要把服务端控制监听暴露到 WAN。"

msgid "Validate"
msgstr "验证"

msgid "armed"
msgstr "已启用"

msgid "Deployment root public key"
msgstr "部署根公钥"

msgid "Signed deployment trust"
msgstr "已签名的部署信任清单"

msgid "Server control signing key"
msgstr "服务端控制签名私钥"

msgid "The deployment root must certify its public key."
msgstr "其公钥必须由部署根认证。"

msgid "Signed control snapshot TTL (seconds)"
msgstr "签名控制快照有效期（秒）"

msgid "Connection mode"
msgstr "连接模式"

msgid "Active (Relay connects to Server)"
msgstr "主动（中继连接服务端）"

msgid "Passive (Server connects to Relay)"
msgstr "被动（服务端连接中继）"

msgid "Server control address"
msgstr "服务端控制地址"

msgid "Passive management seed"
msgstr "被动模式管理种子地址"

msgid "Choose who initiates each authenticated control session. Passive Relays require one stable management seed; active Relays connect to Server and require no stored Relay address. Published management and data endpoints always come from the authenticated Relay."
msgstr "请选择每条认证控制连接由哪一端发起。被动中继需要一个固定的管理种子地址；主动中继自行连接服务端，服务端不保存中继地址。最终发布的管理和数据端点始终来自已认证中继的上报。"
