msgstr "待处理任务有效期（秒）"

msgid "Travel authorization state"
msgstr "旅行端授权状态"

msgid "Control generation state"
msgstr "控制快照代次状态"

msgid "Persistent revocation cache"
msgstr "持久化撤销缓存"

