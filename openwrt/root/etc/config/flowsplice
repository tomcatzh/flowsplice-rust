config flowsplice 'global'
	option log_level 'info'

config server 'server'
	option enabled '0'
	option id 'server-1'
	list control_listen '127.0.0.1:7443'
	list data_listen '127.0.0.1:7444'
	option cert '/etc/flowsplice/pki/server.crt'
	option key '/etc/flowsplice/pki/server.key'
	option management_ca '/etc/flowsplice/pki/management-ca.crt'
	option home_id 'home-1'
	list home_spki_pin 'replace-with-home-spki-sha256-hex'
	list relay_spki_pin 'replace-with-relay-spki-sha256-hex'
	option handshake_timeout_secs '10'
	option work_ttl_secs '15'
	option max_pending_work '256'

config relay 'relay_lan'
	option enabled '0'
	option id 'relay-openwrt-lan'
	option management_listen '192.0.2.1:8443'
	option data_listen '192.0.2.1:8444'
	option data_public_addr '192.0.2.1:8444'
	option server_data_addr '192.0.2.1:7444'
	option server_id 'server-1'
	option cert '/etc/flowsplice/pki/relay-lan.crt'
	option key '/etc/flowsplice/pki/relay-lan.key'
	option management_ca '/etc/flowsplice/pki/management-ca.crt'
	list server_spki_pin 'replace-with-server-spki-sha256-hex'
	list travel_spki_pin 'replace-with-travel-spki-sha256-hex'
	option handshake_timeout_secs '10'
	option route_ttl_secs '15'
	option max_pending_routes '256'

config relay 'relay_wan6'
	option enabled '0'
	option id 'relay-openwrt-wan6'
	option management_listen '[2001:db8::1]:8443'
	option data_listen '[2001:db8::1]:8444'
	option data_public_addr '[2001:db8::1]:8444'
	option server_data_addr '192.0.2.1:7444'
	option server_id 'server-1'
	option cert '/etc/flowsplice/pki/relay-wan6.crt'
	option key '/etc/flowsplice/pki/relay-wan6.key'
	option management_ca '/etc/flowsplice/pki/management-ca.crt'
	list server_spki_pin 'replace-with-server-spki-sha256-hex'
	list travel_spki_pin 'replace-with-travel-spki-sha256-hex'
	option handshake_timeout_secs '10'
	option route_ttl_secs '15'
	option max_pending_routes '256'

config relay_endpoint 'relay_lan_endpoint'
	option enabled '0'
	option id 'relay-openwrt-lan'
	option management_addr '192.0.2.1:8443'
	option server_name 'relay-lan.example.invalid'

config relay_endpoint 'relay_wan6_endpoint'
	option enabled '0'
	option id 'relay-openwrt-wan6'
	option management_addr '[2001:db8::1]:8443'
	option server_name 'relay-wan6.example.invalid'
