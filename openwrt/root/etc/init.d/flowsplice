#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

EXTRA_COMMANDS="validate"
EXTRA_HELP="\tvalidate\tRender and validate every enabled FlowSplice instance"

SERVER_BIN=/usr/bin/flowsplice-server
RELAY_BIN=/usr/bin/flowsplice-relay
RENDERER=/usr/libexec/flowsplice/render-config
RUNTIME_DIR=/var/run/flowsplice
VALIDATION_FAILED=0

validate_as_flowsplice() {
	local binary="$1" config_file="$2" pid_file="$3" result
	rm -f "$pid_file"
	start-stop-daemon -S -x "$binary" -p "$pid_file" -m -c flowsplice:flowsplice -- \
		--config "$config_file" --check-config
	result=$?
	rm -f "$pid_file"
	return "$result"
}

prepare_runtime() {
	mkdir -p "$RUNTIME_DIR"
	mkdir -p /etc/flowsplice/state
	chown flowsplice:flowsplice "$RUNTIME_DIR"
	chown flowsplice:flowsplice /etc/flowsplice/state
	chmod 700 "$RUNTIME_DIR"
	chmod 700 /etc/flowsplice/state
}

validate_relay_section() {
	local section="$1" enabled config_file
	config_get_bool enabled "$section" enabled 0
	[ "$enabled" -eq 1 ] || return 0
	case "$section" in
		''|*[!A-Za-z0-9_]*)
			echo "invalid Relay UCI section name: $section" >&2
			VALIDATION_FAILED=1
			return 0
			;;
	esac
	config_file="$RUNTIME_DIR/relay-${section}.toml"
	if ! "$RENDERER" relay "$section" "$config_file"; then
		VALIDATION_FAILED=1
		return 0
	fi
	chown flowsplice:flowsplice "$config_file"
	chmod 600 "$config_file"
	if ! validate_as_flowsplice "$RELAY_BIN" "$config_file" \
		"$RUNTIME_DIR/validate-relay-${section}.pid"; then
		VALIDATION_FAILED=1
	fi
}

validate() {
	local server_enabled server_config
	prepare_runtime || return 1
	config_load flowsplice
	VALIDATION_FAILED=0
	config_get_bool server_enabled server enabled 0
	if [ "$server_enabled" -eq 1 ]; then
		server_config="$RUNTIME_DIR/server.toml"
		if ! "$RENDERER" server "$server_config"; then
			VALIDATION_FAILED=1
		else
			chown flowsplice:flowsplice "$server_config"
			chmod 600 "$server_config"
			if ! validate_as_flowsplice "$SERVER_BIN" "$server_config" \
				"$RUNTIME_DIR/validate-server.pid"; then
				VALIDATION_FAILED=1
			fi
		fi
	fi
	config_foreach validate_relay_section relay
	[ "$VALIDATION_FAILED" -eq 0 ]
}

start_server_instance() {
	local enabled log_level cert key management_ca
	config_get_bool enabled server enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get log_level global log_level info
	config_get cert server cert
	config_get key server key
	config_get management_ca server management_ca
	procd_open_instance server
	procd_set_param command "$SERVER_BIN" --config "$RUNTIME_DIR/server.toml"
	procd_set_param env "RUST_LOG=flowsplice_server=${log_level}"
	procd_set_param user flowsplice
	procd_set_param group flowsplice
	procd_set_param no_new_privs 1
	procd_set_param limits nofile="4096 4096" core="0 0"
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/flowsplice "$cert" "$key" "$management_ca"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_relay_section() {
	local section="$1" enabled log_level cert key management_ca
	config_get_bool enabled "$section" enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get log_level global log_level info
	config_get cert "$section" cert
	config_get key "$section" key
	config_get management_ca "$section" management_ca
	procd_open_instance "relay_${section}"
	procd_set_param command "$RELAY_BIN" --config "$RUNTIME_DIR/relay-${section}.toml"
	procd_set_param env "RUST_LOG=flowsplice_relay=${log_level}"
	procd_set_param user flowsplice
	procd_set_param group flowsplice
	procd_set_param no_new_privs 1
	procd_set_param limits nofile="4096 4096" core="0 0"
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/flowsplice "$cert" "$key" "$management_ca"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	validate || return 1
	config_load flowsplice
	start_server_instance
	config_foreach start_relay_section relay
}

reload_service() {
	validate || return 1
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger flowsplice
}
